<section class="page-section">
  <div class="container">
    <div class="page-header">
      <div>
        <p class="page-label">Availability</p>
        <h1>My Availability</h1>
        <p>Manage the days and times when you are available for bookings.</p>
      </div>

      <%= link_to "Add Availability",
                  new_provider_availability_path,
                  class: "primary-button" %>
    </div>

    <% if flash[:notice] %>
      <div class="success-message">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="alert-message">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if @availabilities.any? %>
      <div class="service-grid">
        <% @availabilities.each do |availability| %>
          <div class="service-card">
            <h3>
              <%= Date::DAYNAMES[availability.day_of_week] %>
            </h3>

            <p>
              <strong>Start:</strong>
              <%= availability.start_time.strftime("%I:%M %p") %>
            </p>

            <p>
              <strong>End:</strong>
              <%= availability.end_time.strftime("%I:%M %p") %>
            </p>

            <p>
              <strong>Status:</strong>
              <%= availability.active? ? "Active" : "Inactive" %>
            </p>

            <div class="card-actions">
              <%= link_to "Edit",
                          edit_provider_availability_path(availability),
                          class: "secondary-button" %>

              <%= button_to "Delete",
                            delete_provider_availability_path(availability),
                            method: :delete,
                            class: "danger-button",
                            data: {
                              turbo_confirm: "Are you sure you want to delete this availability?"
                            } %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <h2>No availability added</h2>
        <p>Add your working hours so customers know when you are available.</p>

        <%= link_to "Add Availability",
                    new_provider_availability_path,
                    class: "primary-button" %>
      </div>
    <% end %>
  </div>
</section>
