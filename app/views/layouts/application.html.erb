<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Service Connect</title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Service Connect helps customers find trusted service providers.">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container navbar">
        <%= link_to "Service Connect", root_path, class: "logo" %>

        <nav class="nav-links">
          <div class="nav-main-links">
            <%= link_to "Home", root_path %>
            <%= link_to "Services", root_path(anchor: "services") %>
            <%= link_to "Providers", providers_path %>
          </div>

          <div class="nav-user-links">
            <% if user_signed_in? %>
              <%= link_to "Dashboard", dashboard_path %>

              <% if current_user.provider? %>
                <%= link_to "My Bookings", provider_dashboard_path %>
              <% else %>
                <%= link_to "My Bookings", bookings_path %>
              <% end %>

              <%= button_to "Logout",
                            logout_path,
                            method: :delete,
                            class: "logout-button" %>
            <% else %>
              <%= link_to "Login", login_path, class: "login-button" %>
            <% end %>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© 2026 Service Connect. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
