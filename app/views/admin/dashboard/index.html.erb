<div class="admin-dashboard">
  <div class="admin-header">
    <div>
      <h1>Admin Dashboard</h1>
      <p>Manage service provider approvals.</p>
    </div>
  </div>

  <section class="admin-section">
    <div class="stats-grid">
      <% { "Customers" => @stats[:customers], "Providers" => @stats[:providers], "Bookings" => @stats[:bookings], "Completed" => @stats[:completed], "Cancelled" => @stats[:cancelled], "Revenue" => pkr(@stats[:revenue]), "Average booking" => pkr(@stats[:average_booking_value]) }.each do |label, value| %>
        <div class="stat-card"><span><%= label %></span><strong><%= value %></strong></div>
      <% end %>
    </div>
  </section>

  <% if notice.present? %>
    <div class="alert alert-success">
      <%= notice %>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="alert alert-error">
      <%= alert %>
    </div>
  <% end %>

  <!-- Pending Providers -->
  <section class="admin-section">
    <div class="section-header">
      <h2>Pending Providers</h2>
      <span class="count"><%= @pending_providers.count %></span>
    </div>

    <% if @pending_providers.any? %>
      <div class="provider-list">
        <% @pending_providers.each do |provider| %>
          <div class="provider-card">
            <div class="provider-info">
              <h3><%= provider.business_name %></h3>

              <% if provider.user.present? %>
                <p>
                  <strong>Name:</strong>
                  <%= provider.user.first_name %>
                  <%= provider.user.last_name %>
                </p>

                <p>
                  <strong>Email:</strong>
                  <%= provider.user.email %>
                </p>
              <% end %>

              <p>
                <strong>Experience:</strong>
                <%= provider.experience_years || 0 %> years
              </p>

              <% if provider.hourly_rate.present? %>
                <p>
                  <strong>Hourly Rate:</strong>
                  <%= provider.hourly_rate %>
                </p>
              <% end %>
            </div>

            <div class="provider-actions">
              <%= button_to "Approve",
                  admin_approve_provider_path(provider),
                  method: :patch,
                  class: "btn btn-approve" %>

              <%= button_to "Reject",
                  admin_reject_provider_path(provider),
                  method: :patch,
                  class: "btn btn-reject" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state">No providers are waiting for approval.</p>
    <% end %>
  </section>

  <!-- Approved Providers -->
  <section class="admin-section">
    <div class="section-header">
      <h2>Approved Providers</h2>
      <span class="count"><%= @approved_providers.count %></span>
    </div>

    <% if @approved_providers.any? %>
      <div class="provider-list">
        <% @approved_providers.each do |provider| %>
          <div class="provider-card">
            <div class="provider-info">
              <h3><%= provider.business_name %></h3>

              <% if provider.user.present? %>
                <p>
                  <strong>Name:</strong>
                  <%= provider.user.first_name %>
                  <%= provider.user.last_name %>
                </p>

                <p>
                  <strong>Email:</strong>
                  <%= provider.user.email %>
                </p>
              <% end %>

              <p class="status approved">
                Approved
              </p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state">No approved providers yet.</p>
    <% end %>
  </section>

  <!-- Rejected Providers -->
  <section class="admin-section">
    <div class="section-header">
      <h2>Rejected Providers</h2>
      <span class="count"><%= @rejected_providers.count %></span>
    </div>

    <% if @rejected_providers.any? %>
      <div class="provider-list">
        <% @rejected_providers.each do |provider| %>
          <div class="provider-card">
            <div class="provider-info">
              <h3><%= provider.business_name %></h3>

              <% if provider.user.present? %>
                <p>
                  <strong>Name:</strong>
                  <%= provider.user.first_name %>
                  <%= provider.user.last_name %>
                </p>

                <p>
                  <strong>Email:</strong>
                  <%= provider.user.email %>
                </p>
              <% end %>

              <p class="status rejected">
                Rejected
              </p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state">No rejected providers.</p>
    <% end %>
  </section>

  <section class="admin-section">
    <div class="section-header"><h2>Users</h2></div>
    <%= form_with url: admin_dashboard_path, method: :get, class: "admin-search" do |form| %>
      <%= form.search_field :q, value: params[:q], placeholder: "Search by name or email" %>
      <%= form.submit "Search", class: "btn btn-approve" %>
    <% end %>
    <div class="table-wrap"><table><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Action</th></tr></thead><tbody>
      <% @users.each do |user| %><tr><td><%= user.first_name %> <%= user.last_name %><br><small><%= user.email %></small></td><td><%= user.role %></td><td><%= user.status %></td><td>
        <% unless user == current_user %><%= button_to(user.suspended? ? "Reactivate" : "Suspend", user.suspended? ? admin_reactivate_user_path(user) : admin_suspend_user_path(user), method: :patch, class: "btn #{user.suspended? ? 'btn-approve' : 'btn-reject'}", data: { turbo_confirm: "Are you sure?" }) %><% end %>
      </td></tr><% end %>
    </tbody></table></div>
  </section>

  <section class="admin-section">
    <div class="section-header"><h2>Activity log</h2></div>
    <div class="table-wrap"><table><thead><tr><th>When</th><th>Action</th><th>Actor</th><th>Subject</th></tr></thead><tbody>
      <% @activity_logs.each do |log| %><tr><td><%= l(log.created_at, format: :short) %></td><td><%= log.action.humanize %></td><td><%= log.actor&.email || "System" %></td><td><%= log.subject_type %> #<%= log.subject_id %></td></tr><% end %>
    </tbody></table></div>
  </section>
</div>

<style>
  .admin-dashboard {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .admin-header {
    margin-bottom: 30px;
  }

  .admin-header h1 {
    margin-bottom: 8px;
  }

  .admin-header p {
    color: #666;
  }

  .alert {
    padding: 12px 16px;
    border-radius: 6px;
    margin-bottom: 20px;
  }

  .alert-success {
    background: #e8f7ee;
    color: #216e3a;
  }

  .alert-error {
    background: #fdecec;
    color: #a12626;
  }

  .admin-section {
    margin-bottom: 40px;
  }

  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }
  .stat-card { padding: 16px; border-radius: 8px; background: #f3f7fb; display: grid; gap: 6px; }
  .stat-card span, small { color: #667085; } .stat-card strong { font-size: 1.35rem; }
  .table-wrap { overflow-x: auto; background: #fff; border: 1px solid #ddd; border-radius: 8px; }
  table { width: 100%; border-collapse: collapse; } th, td { text-align: left; padding: 12px; border-bottom: 1px solid #eee; }
  .admin-search { display: flex; gap: 8px; margin-bottom: 12px; } .admin-search input { flex: 1; padding: 9px; }

  .section-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
  }

  .section-header h2 {
    margin: 0;
  }

  .count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    padding: 0 8px;
    border-radius: 14px;
    background: #eee;
    font-size: 14px;
  }

  .provider-list {
    display: grid;
    gap: 15px;
  }

  .provider-card {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 20px;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: #fff;
  }

  .provider-info h3 {
    margin-top: 0;
    margin-bottom: 12px;
  }

  .provider-info p {
    margin: 6px 0;
  }

  .provider-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn {
    border: none;
    border-radius: 6px;
    padding: 10px 16px;
    cursor: pointer;
    font-weight: 600;
  }

  .btn-approve {
    background: #198754;
    color: white;
  }

  .btn-reject {
    background: #dc3545;
    color: white;
  }

  .status {
    font-weight: 600;
  }

  .status.approved {
    color: #198754;
  }

  .status.rejected {
    color: #dc3545;
  }

  .empty-state {
    padding: 20px;
    border: 1px dashed #ccc;
    border-radius: 8px;
    color: #666;
  }

  @media (max-width: 700px) {
    .provider-card {
      flex-direction: column;
    }

    .provider-actions {
      align-items: flex-start;
    }
  }
</style>
