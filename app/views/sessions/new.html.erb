<section class="auth-page">
  <div class="auth-card">
    <p class="page-label">Service Connect</p>

    <h1>Welcome Back</h1>

    <p class="auth-description">
      Log in to manage your bookings and find trusted service providers.
    </p>

    <% if flash[:alert] %>
      <div class="alert-message">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: login_path, method: :post, local: true do |form| %>
      <div class="form-group">
        <%= form.label :email %>

        <%= form.email_field :email,
              required: true,
              autofocus: true,
              placeholder: "you@example.com" %>
      </div>

      <div class="form-group">
        <%= form.label :password %>

        <%= form.password_field :password,
              required: true,
              placeholder: "Your password" %>
      </div>

      <%= form.submit "Log In", class: "auth-button" %>
    <% end %>
  </div>
</section>
