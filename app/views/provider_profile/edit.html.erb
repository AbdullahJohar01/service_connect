<section class="page-section">
  <div class="container">
    <div class="page-header">
      <div>
        <p class="page-label">Provider Profile</p>
        <h1>Edit Profile</h1>
        <p>Update your business information and service details.</p>
      </div>
    </div>

    <% if flash[:alert] %>
      <div class="alert-message">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if @provider_profile.errors.any? %>
      <div class="alert-message">
        <strong>Please correct the following:</strong>

        <ul>
          <% @provider_profile.errors.full_messages.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-card">
      <%= form_with model: @provider_profile,
                    url: provider_profile_path,
                    method: :patch,
                    local: true do |form| %>

        <div class="form-group">
          <%= form.label :business_name %>

          <%= form.text_field :business_name,
                required: true,
                placeholder: "Your business name" %>
        </div>

        <div class="form-group">
          <%= form.label :description %>

          <%= form.text_area :description,
                rows: 5,
                placeholder: "Describe your services..." %>
        </div>

        <div class="form-group">
          <%= form.label :experience_years %>

          <%= form.number_field :experience_years,
                min: 0,
                required: true %>
        </div>

        <div class="form-group">
          <%= form.label :hourly_rate %>

          <%= form.number_field :hourly_rate,
                min: 0,
                step: 0.01,
                required: true %>
        </div>

        <div class="form-group">
          <%= form.label :profile_image, "Profile image" %>
          <%= form.file_field :profile_image, accept: "image/jpeg,image/png,image/webp" %>
        </div>

        <div class="form-group">
          <%= form.label :identity_documents, "Identity documents (private)" %>
          <%= form.file_field :identity_documents, multiple: true, accept: "application/pdf,image/jpeg,image/png" %>
        </div>

        <div class="form-group">
          <%= form.label :professional_certificates, "Professional certificates (private)" %>
          <%= form.file_field :professional_certificates, multiple: true, accept: "application/pdf,image/jpeg,image/png" %>
        </div>

        <div class="form-actions">
          <%= form.submit "Save Changes",
                class: "primary-button" %>

          <%= link_to "Cancel",
                provider_profile_path,
                class: "secondary-button" %>
        </div>
      <% end %>
    </div>
  </div>
</section>
