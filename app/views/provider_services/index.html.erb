<section class="page-section">
  <div class="container">
    <div class="page-header">
      <div>
        <p class="page-label">Provider Services</p>
        <h1>My Services</h1>
        <p>Manage the services you offer to customers.</p>
      </div>

      <%= link_to "Add Service",
                  new_provider_service_path,
                  class: "primary-button" %>
    </div>

    <% if flash[:notice] %>
      <div class="success-message">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="alert-message">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if @provider_services.any? %>
      <div class="service-grid">
        <% @provider_services.each do |service| %>
          <div class="service-card">
            <h3>
              <%= service.service_category.name %>
            </h3>

            <p>
              <%= service.description.presence || "No description provided." %>
            </p>

            <p>
              <strong>Price:</strong>
              <%= pkr(service.base_price) %>
            </p>

            <p>
              <strong>Duration:</strong>
              <%= service.duration_minutes %> minutes
            </p>

            <p>
              <strong>Status:</strong>
              <%= service.active? ? "Active" : "Inactive" %>
            </p>

            <div class="card-actions">
              <%= link_to "Edit",
                          edit_provider_service_path(service),
                          class: "secondary-button" %>

              <%= button_to "Delete",
                            provider_service_path(service),
                            method: :delete,
                            class: "danger-button",
                            data: {
                              turbo_confirm: "Are you sure you want to delete this service?"
                            } %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <h2>No services yet</h2>
        <p>Add your first service to start offering it to customers.</p>

        <%= link_to "Add Service",
                    new_provider_service_path,
                    class: "primary-button" %>
      </div>
    <% end %>
  </div>
</section>
